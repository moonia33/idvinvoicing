{
	# Už Coolify/Traefik: perduoti X-Forwarded-Proto/For iš vidinio tinklo proxy,
	# kitaip Django mato http ir CSRF/secure cookie neveikia.
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /admin/* {
		reverse_proxy backend:8000
	}

	handle /static/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
